[Unit]
Description=Glasshouse BLE detector
After=network.target bluetooth.target glasshouse-ap.service
Wants=bluetooth.target

[Service]
Type=simple
ExecStart=/opt/glasshouse/venv/bin/python3 -m glasshouse.main
WorkingDirectory=/opt/glasshouse
Restart=on-failure
RestartSec=5
WatchdogSec=60
EnvironmentFile=-/etc/glasshouse/env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=glasshouse
# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/glasshouse /etc/glasshouse
ProtectHome=yes
PrivateTmp=yes
UMask=0077
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
